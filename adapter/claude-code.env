# SCV Core host-profile contract v1.
#
# This file is consumed only while a pinned core release is materialized. The
# installed plugin never downloads or selects a different core at runtime.
SCV_HOST_PROFILE_API=1
SCV_HOST_ID=claude-code
SCV_HOST_LABEL=Claude Code
SCV_ACTION_TEMPLATE=/scv:{action}
SCV_ARGUMENT_STYLE=template-string
SCV_STATE_INDEX=SCV.md
SCV_LEGACY_STATE_INDEXES=CLAUDE.md|CODEX.md
SCV_ROOT_ENV=CLAUDE_PLUGIN_ROOT
SCV_GRAPH_SKILL_PATHS=$HOME/.claude/skills/graphify/SKILL.md|$HOME/.claude/plugins/cache/*/skills/graphify/SKILL.md
SCV_UPDATE_OWNER=adapter
SCV_MODEL_POLICY_OWNER=adapter
SCV_PROMPTING_GUIDES=prompting
SCV_AUTO_PROMPT_TAGS=task-notification teammate-message
SCV_CHOICE_TOOL=AskUserQuestion
SCV_CHOICE_OFF_WHEN=CLAUDE_CODE_SESSION_ATTENDED=0
SCV_SESSION_ENV=CLAUDE_CODE_SESSION_ID
SCV_AUTO_PROMPT_PREFIX=Another Claude session sent a message:
SCV_AUTO_PROMPT_SUFFIX=This came from another Claude session
SCV_JUDGE_COMMAND=scripts/show-real-judge.sh
SCV_CHOICE_REJECTED_PREFIX=<tool_use_error>
# deck 엔진은 코어 사본 안에 한 벌만 — 스킬은 플러그인 최상위를 코어 루트로 삼아 돌기 때문에 자리를 알려 준다(core 0.72.2+).
SCV_DECKUI_DIR=vendor/scv-core/core/DeckUI
