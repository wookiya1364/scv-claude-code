# OS / editor
.DS_Store
*.swp
*.swo
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Node
node_modules/

# graphify local caches (output itself is committed; these are runtime helpers)
.graphify_python
.graphify_version

# environment files — safety net (this repo is the template, not a hydrated project)
.env
.env.local

# SCV sync backups (created by /scv:sync in hydrated projects)
.scv-backup/

# Scratch
.scratch/
tmp/

# Private user notes — DISCUSS.md is the user's local discussion log
DISCUSS.md

# CHANGELOG.md — local-only (user keeps history privately)
/CHANGELOG.md

# Maintainer-only Core sync lock, transaction, and stale-lock quarantine
/.scv-core-sync.lock/
/.scv-core-transaction.*/
/.scv-core-sync-quarantine.*/

# Remotion demo (Phase 1+) — node_modules ignored
/demo/node_modules
/demo/out

# v0.9.0+ — /scv:help conversation mode (local sketch files, gitignored)
/scv/.conversations/

# This repository builds the plugin; it is not a project that uses it. The
# marketplace ships the whole tracked tree, so anything under scv/ would land in
# every user's plugin payload — plans, conversations, and the hook-fed journal
# alike. The prose rule is "never hydrate this repo"; this line is that rule with
# teeth, for the moment /scv:workspace, /scv:help, or a stray mkdir creates the
# directory anyway.
/scv/
